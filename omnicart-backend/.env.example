# ========================================================
# OmniCart Multi-Source Social & Community Deal Credentials
# Keep this file local on your machine (DO NOT COMMIT TO GIT)
# ========================================================

# 1. Reddit API Credentials (Free at https://www.reddit.com/prefs/apps)
# Click "create another app..." -> select "script" -> Name: OmniCart -> Redirect: http://localhost:8080
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=OmniCart:v1.0 (by /u/YOUR_REDDIT_USERNAME)

# 2. X (Twitter) Session Token (No password required!)
# Log in to x.com -> Press F12 -> Application tab -> Cookies -> https://x.com -> Copy 'auth_token' value
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# 3. Telegram API Credentials (Free at https://my.telegram.org)
# Log in with phone number -> API development tools -> Create app -> Copy api_id & api_hash
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# 4. Optional infrastructure
# Absolute path to a sibling PriceAggregator checkout (enables quick-commerce fixtures).
PRICE_AGGREGATOR_DIR=

# PriceHistoryApp request-signing secret. Leave empty to disable that API.
PRICEHISTORY_SECRET=
